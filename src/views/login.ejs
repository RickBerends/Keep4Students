<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#12121a">
<title><%= title %></title>
<link rel="stylesheet" href="/styles.css">
</head>
<body>
<div class="wrap">
  <h1><%= title %></h1>
  <p class="muted">Type the event code, pick a team name. Everyone on your team
  types the <em>same</em> team name to play together.</p>

  <% if (error) { %>
    <p class="alert error"><%= error %></p>
  <% } %>

  <form method="post" action="/login" class="stack">
    <label>
      Event code
      <input name="code" autocomplete="off" autocapitalize="characters"
             autocorrect="off" spellcheck="false" required>
    </label>
    <label>
      Team name
      <input name="teamName" value="<%= teamName %>" autocomplete="off"
             maxlength="40" required>
    </label>
    <button type="submit">Start</button>
  </form>
</div>
</body>
</html>

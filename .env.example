# Copy to .env for local dev. On Fly/Railway set these as secrets/vars instead.

# Where SQLite + uploaded media live. Use /data in production (mounted volume).
DATA_DIR=./data

# Port the server listens on.
PORT=3000

# Password for the /admin dashboard. CHANGE THIS.
ADMIN_PASSWORD=changeme

# Event code teams must type to log in. Overrides the value in src/content/crawl.ts.
# EVENT_CODE=CRAWL2026

# Hard ceiling on a single upload, in megabytes.
MAX_UPLOAD_MB=400
